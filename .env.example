# Copy to .env and fill in values.  Never commit .env.

# Neon (or any Postgres) connection string
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Clerk — from your Clerk dashboard
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Random secret used to hash plate numbers — treat like a password
PLATE_PEPPER=change-me-before-deploying

# Server
PORT=8080

# CORS — the URL of your frontend (plate-review-web)
CORS_ORIGIN=http://localhost:3000
