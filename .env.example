# Copy to .env and fill in values.  Never commit .env.

# Neon (or any Postgres) connection string
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Clerk — from your Clerk dashboard
CLERK_SECRET_KEY=sk_test_...
# CLERK_JWT_KEY must be a SINGLE LINE with literal \n between PEM lines.
# Paste your key from the Clerk dashboard, then collapse newlines:
#   awk '{printf "%s\\n", $0}' your_key.pem | tr -d '\n'
# Result looks like: -----BEGIN PUBLIC KEY-----\nMIIBIjAN...\n-----END PUBLIC KEY-----
CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjAN...\n-----END PUBLIC KEY-----

# Random secret used to hash plate numbers — treat like a password
PLATE_PEPPER=change-me-before-deploying

# Server
PORT=8080

# CORS — the URL of your frontend (plate-review-web)
CORS_ORIGIN=http://localhost:3000
